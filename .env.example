# Supabase API (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Legacy name still supported:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only — never expose to the browser (Settings → API → secret / service_role key)
SUPABASE_SECRET_KEY=your_supabase_secret_key
# Legacy name still supported:
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Supabase PostgreSQL (Settings → Database → Connection string)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Backblaze B2 (S3-compatible)
B2_APPLICATION_KEY_ID=your_b2_key_id
B2_APPLICATION_KEY=your_b2_application_key
B2_BUCKET_NAME=your_bucket_name
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
NEXT_PUBLIC_B2_PUBLIC_URL=https://f004.backblazeb2.com/file/your-bucket
# Friendly S3 endpoint region must match B2 bucket (e.g. us-west-003 → f003.backblazeb2.com)

# Resend (transactional email)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM="cbrilliancefc <support@cbrilliancefc.com>"
# Optional — defaults to the address in RESEND_FROM
# ADMIN_NOTIFICATION_EMAIL=support@cbrilliancefc.com

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=1234567890
NEXT_PUBLIC_CONTACT_EMAIL=info@cbfc.com
NEXT_PUBLIC_CONTACT_PHONE=+1234567890

# Optional — AES-256-GCM encryption for secrets stored at rest (32+ characters)
# SECRETS_ENCRYPTION_KEY=your-long-random-secret-key-here
# ADMIN_SEED_EMAIL=admin@example.com
# ADMIN_SEED_PASSWORD=ChangeMe123456
